{
  "Auth": {
    "MetadataAddress": "http://localhost:5001/.well-known/openid-configuration",
    "Issuer": "auth-service",
    "Audience": "crm-api",
    "RequireHttpsMetadata": false
  },
  "ReverseProxy": {
    "Routes": {
      "auth": {
        "ClusterId": "auth",
        "AuthorizationPolicy": "anonymous",
        "Match": { "Path": "/auth/{**catch-all}" }
      },
      "contacts-read": {
        "ClusterId": "contacts",
        "AuthorizationPolicy": "contacts.read",
        "Match": { "Path": "/api/contacts/{**catch-all}", "Methods": [ "GET" ] },
        "Transforms": [ { "PathRemovePrefix": "/api" } ]
      },
      "contacts-write": {
        "ClusterId": "contacts",
        "AuthorizationPolicy": "contacts.write",
        "Match": { "Path": "/api/contacts/{**catch-all}", "Methods": [ "POST", "PUT", "PATCH", "DELETE" ] },
        "Transforms": [ { "PathRemovePrefix": "/api" } ]
      }
    },
    "Clusters": {
      "auth":     { "Destinations": { "d1": { "Address": "http://localhost:5001/" } } },
      "dataservice": { "Destinations": { "d1": { "Address": "http://localhost:5002/" } } }
    }
  },
  "Logging": { "LogLevel": { "Default": "Information", "Yarp": "Information" } },
  "AllowedHosts": "*"
}
